  <actions>
    <action caption='Highlight1' name='[Action1]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Global Burden Overview' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Country or territory name,Region' />
        <param name='target' value='Global Burden Overview' />
      </command>
    </action>
    <action caption='Highlight2' name='[Action2]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Evolution of TB Indicators Across Regions' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Year' />
        <param name='target' value='Evolution of TB Indicators Across Regions' />
      </command>
    </action>
    <action caption='Highlight3' name='[Action3]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='HIV Influence on TB' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Year' />
        <param name='target' value='HIV Influence on TB' />
      </command>
    </action>
    <action caption='Highlight4' name='[Action4]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Case Detection Rate' type='sheet' />
      <command command='tsc:brush'>
        <param name='field-captions' value='Year' />
        <param name='target' value='Case Detection Rate' />
      </command>
    </action>
  </actions>
  <worksheets>
    <worksheet name='AFR Detection in time'>
      <layout-options>
        <title>
          <formatted-text>
            <run>AFR Detection in time</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TB_Burden_Country.csv+ (Multiple Connections)' name='federated.0zhhfdu026jylp15t8zxa1k1j3ex' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='starting year' datatype='integer' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='1990'>
              <calculation class='tableau' formula='1990' />
              <range max='2013' min='1990' />
            </column>
            <column caption='end year' datatype='integer' name='[Parameter 3]' param-domain-type='range' role='measure' type='quantitative' value='2013'>
              <calculation class='tableau' formula='2013' />
              <range max='2013' min='1990' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0zhhfdu026jylp15t8zxa1k1j3ex'>
            <column caption='year range filter' datatype='boolean' name='[Calculation_1525312966524956677]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Year] &gt;= [Parameters].[Parameter 2] AND [Year] &lt;= [Parameters].[Parameter 3]' />
            </column>
            <column datatype='real' name='[Case detection rate (all forms), percent]' role='measure' type='quantitative' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
